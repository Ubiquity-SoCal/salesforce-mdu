<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>Before-save autofill: if CloseDate is null on insert, sets it to TODAY()+365. Lets Business and MDU Opp record pages show CloseDate as read-only without blocking creation. Projected_Close_Date__c is the real forecast field; CloseDate is a standard SF field we can't make optional, so we auto-populate it.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Default CloseDate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Default CloseDate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <status>Active</status>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector><targetReference>set_close_date</targetReference></connector>
        <filterFormula>ISBLANK({!$Record.CloseDate})</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <recordUpdates>
        <name>set_close_date</name>
        <label>Set CloseDate</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <inputAssignments>
            <field>CloseDate</field>
            <value><elementReference>$Flow.CurrentDate</elementReference></value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
</Flow>
