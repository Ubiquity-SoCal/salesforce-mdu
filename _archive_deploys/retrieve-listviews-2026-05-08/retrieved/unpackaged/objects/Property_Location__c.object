        <externalId>false</externalId>
        <formula>TEXT(YEAR(FDH_Activated_Date__c)) &amp; &quot;-&quot; &amp; 
CASE(
  MONTH(FDH_Activated_Date__c),
  1, &quot;01&quot;,
  2, &quot;02&quot;,
  3, &quot;03&quot;,
  4, &quot;04&quot;,
  5, &quot;05&quot;,
  6, &quot;06&quot;,
  7, &quot;07&quot;,
  8, &quot;08&quot;,
  9, &quot;09&quot;,
 10, &quot;10&quot;,
 11, &quot;11&quot;,
 12, &quot;12&quot;,
  &quot;00&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Year - Month FDH Activation</label>
