    <fields>
        <fullName>GIS_Review_Quarter__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(YEAR(GIS_Review_Date__c)) &amp;
&quot;Q&quot; &amp;
CASE(
  CEILING(MONTH(GIS_Review_Date__c) / 3),
  1, &quot;1&quot;,
  2, &quot;2&quot;,
  3, &quot;3&quot;,
  4, &quot;4&quot;,
  &quot;?&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>GIS Review Quarter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
