    <nameField>
        <label>Property Location ID</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Property Locations</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Lock_Property_Location_ID</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
  ISCHANGED(Name),
  NOT(ISNEW())
)</errorConditionFormula>
        <errorMessage>Property Location ID cannot be changed after the record is created.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
