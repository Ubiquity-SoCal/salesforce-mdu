        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>Priority__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  Hold__c = TRUE,
  &quot;Hold&quot;,

  IF(
    Active_Unit_Count__c = Property_Unit_Count__c,
    &quot;All Active&quot;,

    IF(
      AND(Property_Unit_Count__c = 1, Active_Unit_Count__c = 0),
      &quot;Category 3&quot;,

      IF(
        AND(
          Property_Unit_Count__c &gt; 1,
          OR(
            Active_Unit_Count__c &gt; 0,
            Deactive_Unit_Count__c &gt; 0
          )
        ),
        &quot;Category 1&quot;,

        IF(
          AND(Property_Unit_Count__c &gt; 1, Active_Unit_Count__c = 0),
          &quot;Category 2&quot;,
          &quot;&quot;
        )
      )
    )
  )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Priority</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Property_Customer_Bucket__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  AND(NOT(ISBLANK(Active_Unit_Count__c)), Active_Unit_Count__c = Property_Unit_Count__c),
  &quot;All units have customer&quot;,
  IF(
    Active_Unit_Count__c &gt; 0,
    &quot;Units with active customer&quot;,
    &quot;Units with no active customer&quot;
  )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Property Customer Bucket</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
