    <fields>
        <fullName>Address_Type__c</fullName>
        <description>Vetro properties.addtype: Business (BUS) for commercial addresses keyed by Business Base Address; MDU for multi-dwelling complexes keyed by Agreement Name; SFU for agreement-grouped single-family units (RV resorts, HOAs, mobile-home parks) keyed by Agreement Name.</description>
        <externalId>false</externalId>
        <label>Address Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Business</fullName>
                    <default>false</default>
                    <label>Business</label>
                </value>
                <value>
                    <fullName>MDU</fullName>
                    <default>false</default>
                    <label>MDU</label>
                </value>
                <value>
                    <fullName>SFU</fullName>
                    <default>false</default>
                    <label>SFU</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Agreement_Name__c</fullName>
        <description>Cross-system agreement identifier from Vetro properties.agreename. Used to group MDU and SFU Property_Locations under a single pursuit (e.g. &quot;Mesa_MDU_Mesa Regal RV Resort&quot;). For business addresses, this field is generally blank since each address is its own pursuit.</description>
        <externalId>false</externalId>
        <label>Agreement Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>All_Units_Active_Icon__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
