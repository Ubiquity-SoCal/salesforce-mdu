    <fields>
        <fullName>AM_Flag_RE_to_Review__c</fullName>
        <defaultValue>false</defaultValue>
        <externalId>false</externalId>
        <inlineHelpText>Address Management Flag for RE to Review</inlineHelpText>
        <label>AM - Flag RE to Review</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>AM_Review_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    NOT(ISBLANK(RE_Review_Notes_AM__c)),
    &quot;RE Reviewed&quot;,
    IF(
        AM_Flag_RE_to_Review__c,
        &quot;Pending RE Review&quot;,
        IF(
            NOT(ISBLANK(TEXT(AM_Status__c))),
            TEXT(AM_Status__c),
            &quot;&quot;
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>AM Review Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
