        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND( ISPICKVAL({!$Record.Status__c}, &quot;Completed&quot;), NOT(ISBLANK({!$Record.Opportunity__c})), NOT(ISBLANK({!$Record.Signed_Date__c})) )</filterFormula>
