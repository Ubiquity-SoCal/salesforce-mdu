<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Campaign Dashboard Access</label>
    <description>Grants access needed to view the Campaign record page dashboard (campaignDashboard LWC): Apex controller + FLS on fields not in the default profile grants. Assign to non-admin users who need to see Campaign project dashboards.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>CampaignDashboardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Campaign</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Opportunity.Submitted_to_Market__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Submitted_to_FiberFirst__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Campaign.Resolution_Stage__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
</PermissionSet>
