                    var stUrl  = lightningUrl + '/lightning/r/SiteTracker_Project__c/' + r.Id + '/view';
                    var hasOpp = !!r.Opportunity__c;
                    var oppUrl = hasOpp ? (lightningUrl + '/lightning/r/Opportunity/' + r.Opportunity__c + '/view') : '';
                    var oppName = hasOpp && r.Opportunity__r ? r.Opportunity__r.Name : '';
                    var state   = r.Opportunity__r ? (r.Opportunity__r.Property_State__c || '') : '';
                    var units   = (r.Opportunity__r && r.Opportunity__r.Units__c) ? r.Opportunity__r.Units__c : 0;
                    var owner   = (r.Opportunity__r && r.Opportunity__r.Owner) ? r.Opportunity__r.Owner.Name : '';
                    var siteLabel = (r.Site_Name__c || r.Name || '');
                    var projNum = r.Name || '';
                    html += '<tr>';
                    if (hasOpp) {
                        html += '<td><a class="opp-link" href="' + oppUrl + '" target="_blank">' + oppName + '</a></td>';
                    } else {
                        html += '<td></td>';
                    }
                    html += '<td><a class="opp-link" href="' + stUrl + '" target="_blank">' + siteLabel + '</a>';
                    if (projNum && projNum !== siteLabel) {
                        html += ' <span style="color:#706e6b;font-size:0.75rem;">(' + projNum + ')</span>';
                    }
                    html += '</td>';
                    html += '<td>' + (r.Build_Status__c || '') + '</td>';
                    html += '<td>' + (r.Activation_Forecast__c || '') + '</td>';
                    html += '<td>' + state + '</td>';
                    html += '<td style="text-align:right">' + units + '</td>';
                    html += '<td>' + owner + '</td>';
                    html += '<td>' + renderSTAgreementBadges(r.Opportunity__c) + '</td>';
                    html += '</tr>';
                });
            }

            html += '<div class="section"><div class="section-title">Forecasted Activations (' + execInProgressST.length + ')</div>';
            if (execInProgressST.length === 0) {
                html += '<div class="empty-state">No projects with a forecasted activation date</div>';
            } else {
                html += '<table><thead><tr><th>Opportunity</th><th>SiteTracker Project</th><th>Build Status</th><th>Activation Forecast</th><th>State</th><th style="text-align:right">Units</th><th>Owner</th><th>Agreements</th></tr></thead><tbody>';

                // Past Due
                html += '<tr><td colspan="8" style="background:#fef0ef;padding:8px 10px;font-weight:700;font-size:0.8rem;color:#c23934;border-bottom:2px solid #c23934;">Past Due (' + stPastDue.length + ')</td></tr>';
                if (stPastDue.length === 0) { html += '<tr><td colspan="8" class="empty-state">None</td></tr>'; } else { renderSTBucketRows(stPastDue); }

                // Next 30
                html += '<tr><td colspan="8" style="background:#e5f6fd;padding:8px 10px;font-weight:700;font-size:0.8rem;color:#0176d3;border-bottom:2px solid #0176d3;">Next 30 Days (' + stNext30.length + ')</td></tr>';
                if (stNext30.length === 0) { html += '<tr><td colspan="8" class="empty-state">None</td></tr>'; } else { renderSTBucketRows(stNext30); }

                // 30-60
                html += '<tr><td colspan="8" style="background:#e5f6fd;padding:8px 10px;font-weight:700;font-size:0.8rem;color:#06a59a;border-bottom:2px solid #06a59a;">30-60 Days (' + stNext60.length + ')</td></tr>';
                if (stNext60.length === 0) { html += '<tr><td colspan="8" class="empty-state">None</td></tr>'; } else { renderSTBucketRows(stNext60); }

                // 60-90
                html += '<tr><td colspan="8" style="background:#e5f6fd;padding:8px 10px;font-weight:700;font-size:0.8rem;color:#e68619;border-bottom:2px solid #e68619;">60-90 Days (' + stNext90.length + ')</td></tr>';
                if (stNext90.length === 0) { html += '<tr><td colspan="8" class="empty-state">None</td></tr>'; } else { renderSTBucketRows(stNext90); }

                // 90+
                html += '<tr><td colspan="8" style="background:#f4f6f9;padding:8px 10px;font-weight:700;font-size:0.8rem;color:#706e6b;border-bottom:2px solid #706e6b;">90+ Days (' + stOver90.length + ')</td></tr>';
                if (stOver90.length === 0) { html += '<tr><td colspan="8" class="empty-state">None</td></tr>'; } else { renderSTBucketRows(stOver90); }

                html += '</tbody></table>';
            }
            html += '</div>';

            html += '</div>'; // end sitetracker tab

            document.getElementById('dashboard').innerHTML = html;
            document.getElementById('dashboard').className = '';

            // Render the Market Penetration tab body now that its container exists in the DOM.
            // recs() extracts the .records array from the SOQL response wrapper.
            renderMarketPen(recs(results[36]), recs(results[37]), recs(results[38]));
            renderByOwner(recs(results[39]));
        }).catch(function(err) {
            document.getElementById('dashboard').innerHTML = '<div style="color:red;">Error loading dashboard: ' + err.message + '</div>';
        });
    }

    // Initial load
    loadDashboard();
    </script>
</body>
</html>
</apex:page>