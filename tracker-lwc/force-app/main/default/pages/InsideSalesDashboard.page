            }
            html += '<div class="metric-card"><div class="metric-label">Completed</div><div class="metric-value" style="color:#2e844a;">' + execCompleted.cnt + '</div><div class="metric-sub">' + Number(execCompleted.units || 0).toLocaleString() + ' units</div></div>';
            html += '<div class="metric-card"><div class="metric-label">Agreements Signed ' + new Date().getFullYear() + '</div><div class="metric-value" style="color:#e68619;">' + totalSignedYTD + '</div></div>';
