                    html += '<td style="text-align:center;">' + allTimeGrand + '</td></tr>';
                }
                html += '</table>';
            }
            // Footnote: clarify grain — counts agreements (PAL/ROE/EMA/BULK/etc.), not properties
            html += '<div style="margin-top:10px;padding:8px 12px;background:#f8f9fa;border-left:3px solid #706e6b;font-size:0.7rem;color:#3e3e3c;line-height:1.5;">';
            html += '<strong>* Grain note:</strong> Counts <strong>agreements signed</strong>, not properties. One property can stack multiple agreements over its lifecycle (PAL &rarr; ROE &rarr; EMA &rarr; BULK), so this total will run higher than the funnel\'s site count. Use the funnel for "how many properties" and this table for "how many contracts executed".';
            html += '</div>';
            html += '</div>';

            html += '</div>'; // end two-col

            // Completed This Year — collapsible
