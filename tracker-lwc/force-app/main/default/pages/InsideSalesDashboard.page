            var funnelColors = ['#1F3A68', '#2C5BA0', '#3a7bd5', '#4D9DE0', '#2E7D32', '#43A047', '#66BB6A'];
            var FW = 600, FH = 350;
            var FTOP = 1.0, FBOT = 0.30; // 100% wide at top, 30% at bottom
            var nF = funnelStages.length;
            var segH = FH / nF;
            html += '<div style="display:flex;justify-content:center;padding:6px 0;">';
            html += '<svg viewBox="0 0 ' + FW + ' ' + FH + '" preserveAspectRatio="xMidYMid meet" style="width:100%;max-width:' + FW + 'px;height:auto;">';
            funnelStages.forEach(function(s, i) {
                var cnt = funnelMap[s] ? funnelMap[s].cnt : 0;
                var units = funnelMap[s] ? (funnelMap[s].units || 0) : 0;
                var topPct = FTOP - ((FTOP - FBOT) * (i / nF));
                var botPct = FTOP - ((FTOP - FBOT) * ((i + 1) / nF));
                var topW = FW * topPct, botW = FW * botPct;
                var topX1 = (FW - topW) / 2, topX2 = topX1 + topW;
                var botX1 = (FW - botW) / 2, botX2 = botX1 + botW;
                var yT = i * segH, yB = (i + 1) * segH;
                var pts = topX1 + ',' + yT + ' ' + topX2 + ',' + yT + ' ' + botX2 + ',' + yB + ' ' + botX1 + ',' + yB;
                var labelY = yT + segH / 2;
                var unitText = cnt + ' sites' + (units ? ' &#183; ' + Number(units).toLocaleString() + ' units' : '');
                html += '<polygon points="' + pts + '" fill="' + funnelColors[i % funnelColors.length] + '" stroke="#fff" stroke-width="1.5"></polygon>';
                html += '<text x="' + (FW / 2) + '" y="' + (labelY - 6) + '" text-anchor="middle" fill="#fff" font-size="13" font-weight="700" style="font-family:Salesforce Sans, Arial, sans-serif;">' + s + '</text>';
                html += '<text x="' + (FW / 2) + '" y="' + (labelY + 12) + '" text-anchor="middle" fill="#fff" font-size="11" opacity="0.92" style="font-family:Salesforce Sans, Arial, sans-serif;">' + unitText + '</text>';
            });
            html += '</svg>';
            html += '</div>';
            // Footnote: explain how Active Pipeline + CX/Launch reconcile to the funnel total
            var funnelTotal = totalPipelineCount + cxLaunchCount;
            html += '<div style="margin-top:10px;padding:8px 12px;background:#f8f9fa;border-left:3px solid #706e6b;font-size:0.7rem;color:#3e3e3c;line-height:1.5;">';
            html += '<strong>Funnel (' + funnelTotal + '):</strong> open MDU sites, Cat 1 only, Projected_Close_Date set, not yet SiteTracker-activated.<br>';
            html += '<strong style="color:#032d60;">Active Pipeline (' + totalPipelineCount + ')</strong> = pre-PAL stages + late-stage with an agreement still in Create / Review / Sign.<br>';
            html += '<strong style="color:#43A047;">CX/Launch (' + cxLaunchCount + ')</strong> = late-stage (PAL/ROE Complete onward), all agreements signed.';
            html += '</div>';
