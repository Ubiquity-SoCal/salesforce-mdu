            html += '<table style="margin-bottom:12px;"><tr><th>Month</th><th style="text-align:right">Count</th><th style="text-align:right">Units</th></tr>';
            for (var cmi = 1; cmi <= currentMonth; cmi++) {
                var cmd = completedMonthMap[cmi] || {cnt: 0, units: 0};
                if (cmd.cnt > 0) {
                    html += '<tr><td>' + months[cmi - 1] + '</td><td style="text-align:right">' + cmd.cnt + '</td><td style="text-align:right">' + Number(cmd.units).toLocaleString() + '</td></tr>';
                }
            }
            html += '<tr style="font-weight:700;border-top:2px solid #e5e5e5;"><td>Total</td><td style="text-align:right">' + completedYTDCount + '</td><td style="text-align:right">' + Number(completedYTDUnits).toLocaleString() + '</td></tr>';
            html += '</table>';

            // Detail table
            if (execCompletedDetail.length > 0) {
                html += '<table><tr><th>Site Name</th><th>Type</th><th>Stage</th><th>Close Date</th><th style="text-align:right">Units</th><th>Owner</th></tr>';
                execCompletedDetail.forEach(function(r) {
                    html += '<tr>';
                    html += '<td><a class="opp-link" href="' + lightningUrl + '/lightning/r/Opportunity/' + r.Id + '/view" target="_blank">' + escHtml(r.Name) + '</a></td>';
