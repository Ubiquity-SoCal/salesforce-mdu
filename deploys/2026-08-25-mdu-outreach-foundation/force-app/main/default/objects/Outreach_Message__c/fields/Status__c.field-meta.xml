            <value><fullName>Drafted</fullName><default>false</default><label>Drafted</label></value>
            <value><fullName>Sending</fullName><default>false</default><label>Sending</label></value>
            <value><fullName>Sent</fullName><default>false</default><label>Sent</label></value>
            <value><fullName>Failed</fullName><default>false</default><label>Failed</label></value>
            <value><fullName>Suppressed</fullName><default>false</default><label>Suppressed</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
