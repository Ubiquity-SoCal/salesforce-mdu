<?xml version="1.0" encoding="UTF-8"?>
<ReportType xmlns="http://soap.sforce.com/2006/04/metadata">
    <baseObject>Opportunity</baseObject>
    <category>opportunities</category>
    <deployed>true</deployed>
    <description>One row per Opportunity. Shows the single highest-priority linked contact (Primary_Contact__c) with their phone, email and property management company, plus Contact Count for how many contacts exist in total. No join, so no row fan-out. Use MDU Opportunities with Contacts if you need to see every contact.</description>
    <label>MDU Opportunities with Primary Contact</label>
