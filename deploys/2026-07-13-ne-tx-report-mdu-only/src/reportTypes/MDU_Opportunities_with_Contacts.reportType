<?xml version="1.0" encoding="UTF-8"?>
<ReportType xmlns="http://soap.sforce.com/2006/04/metadata">
    <baseObject>Opportunity</baseObject>
    <category>opportunities</category>
    <deployed>true</deployed>
    <description>Opportunities with their linked Contacts (via Opportunity_Contact__c). Outer join: Opportunities with no contact still appear, which is the point -- most have none.</description>
    <join>
        <outerJoin>true</outerJoin>
        <relationship>Opportunity_Contacts__r</relationship>
    </join>
    <label>MDU Opportunities with Contacts</label>
